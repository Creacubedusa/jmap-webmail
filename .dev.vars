# App name displayed in the UI
APP_NAME=QisMail

# JMAP server URL (required)
# This is the URL of your JMAP-compatible mail server
JMAP_SERVER_URL=https://mail.que.email
# Log format: "text" (colored, human-readable) or "json" (structured, for log aggregation)
LOG_FORMAT=text

# Log level: "error", "warn", "info", or "debug"
LOG_LEVEL=info

# NEXT_PUBLIC_APP_NAME=QisMail
# NEXT_PUBLIC_JMAP_SERVER_URL=https://mail.que.email
