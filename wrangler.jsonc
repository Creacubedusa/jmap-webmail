{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "queis-mail",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "queis-mail"
    }
  ],
  "limits": {
    "cpu_ms": 30000
  },
  "dev": {
    "ip": "0.0.0.0",
  }
}
